# Copy to .env for local runs. Never commit real keys.

# mock = fully offline, deterministic providers; live = LiteLLM to real vendors
PROVIDER_MODE=mock

# Ordered fallback chains (first = primary). LiteLLM model names in live mode.
CUSTOMER_MODELS=mock/fast-a,mock/fast-b
COACH_MODELS=mock/smart-a,mock/smart-b
JUDGE_MODELS=mock/smart-b
# Live example (check each vendor's current model list; names change):
# CUSTOMER_MODELS=openai/<fast-model>,gemini/<fast-model>
# COACH_MODELS=anthropic/<strong-model>,openai/<strong-model>
# JUDGE_MODELS=openai/<strong-model>

# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=

REQUEST_TIMEOUT_S=20
MAX_RETRIES=1
RATE_LIMIT_RPM=600
BREAKER_FAILURE_THRESHOLD=5
BREAKER_RESET_S=30
MEMORY_TOKEN_BUDGET=1200
ONLINE_EVAL_SAMPLE_RATE=0.2
EXPERIMENT_NAME=customer_prompt_v2
DB_PATH=coach.db
LOG_LEVEL=INFO

# Optional tracing (needs the otel extra), e.g. an OpenTelemetry collector
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# Offline fault injection for the mock providers
# MOCK_FAILURE_RATES=mock/fast-a=0.2,mock/smart-a=0.2
# MOCK_BAD_JSON_RATE=0.1
